# =========================================================
# StudyTruth AI - environment configuration
# Copy this file to .env and fill in real values if you have
# access to Microsoft Foundry / Azure AI Search. If you leave
# these blank, the app automatically runs in LOCAL MOCK MODE
# using on-device TF-IDF embeddings and an extractive/template
# answer engine, so the whole product still works end-to-end.
# =========================================================

# ---- Microsoft Foundry (LLM) ----
# Foundry-hosted chat model endpoint, e.g. https://<resource>.services.ai.azure.com/models
FOUNDRY_ENDPOINT=
# Foundry / Azure AI API key (never commit real keys)
FOUNDRY_API_KEY=
# Deployment / model name, e.g. gpt-4o-mini
FOUNDRY_MODEL=gpt-5-mini
# Foundry API version
FOUNDRY_API_VERSION=2024-05-01-preview

# ---- Microsoft Foundry IQ (managed knowledge / RAG layer) ----
# Foundry IQ knowledge source id (a "knowledge index" built from the same
# documents that this app ingests locally). See README "Foundry IQ mapping".
FOUNDRY_IQ_KNOWLEDGE_SOURCE=
FOUNDRY_IQ_ENABLED=false

# ---- Microsoft AI Search ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=studytruth-documents

# ---- App behaviour ----
# true|false - forces local mock mode even if keys above are present
FORCE_LOCAL_MODE=true
APP_ENV=development
LOG_LEVEL=INFO

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5500
